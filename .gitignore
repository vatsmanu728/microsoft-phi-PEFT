
# datasets — train.csv is too large for git (1.2GB, over GitHub's 100MB hard limit)
# validation.csv and test.csv ARE committed intentionally — small enough, and lets anyone clone the repo and run evaluation immediately
dataset/raw/train.csv
dataset/processed/

# models — base weights never committed (too large, re-downloaded each session)
models/base/

# LoRA: only intermediate training checkpoints are ignored — 
# the FINAL adapter (copied into models/lora/ after training completes) IS committed
models/lora/checkpoint-*/

# secrets/env
.env
*.key

# python
__pycache__/
*.pyc
.ipynb_checkpoints/
venv/
